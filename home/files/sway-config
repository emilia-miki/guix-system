# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables

set $ipc noctalia msg
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu $ipc panel-toggle launcher

set $ws1  一
set $ws2  二
set $ws3  三
set $ws4  四
set $ws5  五
set $ws6  六
set $ws7  七
set $ws8  八
set $ws9  九
set $ws10 十

seat seat0 xcursor_theme Adwaita 24

default_border pixel 2
gaps inner 5

include ~/.config/sway/noctalia
exec dbus-update-activation-environment --all
exec noctalia
exec udiskie -t
exec fcitx5 -d
exec gpg-connect-agent updatestartuptty /bye
exec brightnessctl -d kbd_backlight s 100%
# exec_always swaymsg border none

### Output configuration
#
output * scale 1.5
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

assign [app_id="feishin"] workspace $ws1
assign [app_id="librewolf"] workspace $ws2
assign [app_id="org.telegram.desktop"] workspace $ws2
assign [app_id="emacs"] workspace $ws3

for_window [app_id="librewolf"] layout tabbed
for_window [app_id="org.telegram.desktop"] layout tabbed

exec emacs
exec librewolf
exec Telegram
exec feishin

### Idle configuration
#
# Example configuration:
#
# swayidle disabled — no auto-lock, screen-off, or suspend
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
input "1452:641:Apple_SPI_Trackpad" {
    dwt disabled
    tap enabled
}

input "1452:641:Apple_SPI_Keyboard" {
    xkb_options ctrl:hyper_capscontrol
    
}
