# MangoWM configuration

cursor_theme=Adwaita

### Input
xkb_rules_options=ctrl:hyper_capscontrol
tap_to_click=1
disable_while_typing=0
trackpad_natural_scrolling=1
click_method=2
middle_button_emulation=1

### Output
monitorrule=name:eDP-1,scale:1.5

### Appearance
focus_on_activate=0
borderpx=2
animations=0
tab_bar_height=24
tab_bar_decorate_font_desc=Sarasa Term J 10
tab_bar_decorate_border_width=1
tab_bar_decorate_padding_x=8
tab_bar_decorate_padding_y=3
tab_bar_decorate_bg_color=0x191724ff
tab_bar_decorate_focus_bg_color=0x26233aff
tab_bar_decorate_border_color=0x656182ff
tab_bar_decorate_corner_radius=0

### Autostart
exec-once=dbus-update-activation-environment --all
exec-once=noctalia
exec-once=udiskie -t
exec-once=fcitx5 -d
exec-once=gpg-connect-agent updatestartuptty /bye
exec-once=brightnessctl -d kbd_backlight s 100%

### Application startup
exec-once=emacs
exec-once=librewolf
exec-once=Telegram
exec-once=feishin

### Window rules — tag assignments
windowrule=tags:1,appid:feishin
windowrule=tags:2,appid:librewolf
windowrule=tags:2,appid:org.telegram.desktop
windowrule=tags:3,appid:emacs

### Tag layout defaults
tagrule=id:2,layout_name:monocle

### Keybindings
# Basics
bind=SUPER,Return,spawn,foot
bind=SUPER+SHIFT,q,killclient
bind=SUPER,d,spawn,noctalia msg panel-toggle launcher
bind=SUPER+SHIFT,c,reload_config
bind=SUPER+SHIFT,e,quit

# Cycle through windows (useful in monocle)
bind=SUPER,Tab,focusstack,next

# Focus
bind=SUPER,h,focusdir,left
bind=SUPER,j,focusdir,down
bind=SUPER,k,focusdir,up
bind=SUPER,l,focusdir,right
bind=SUPER,Left,focusdir,left
bind=SUPER,Down,focusdir,down
bind=SUPER,Up,focusdir,up
bind=SUPER,Right,focusdir,right

# Move
bind=SUPER+SHIFT,h,exchange_client,left
bind=SUPER+SHIFT,j,exchange_client,down
bind=SUPER+SHIFT,k,exchange_client,up
bind=SUPER+SHIFT,l,exchange_client,right
bind=SUPER+SHIFT,Left,exchange_client,left
bind=SUPER+SHIFT,Down,exchange_client,down
bind=SUPER+SHIFT,Up,exchange_client,up
bind=SUPER+SHIFT,Right,exchange_client,right

# Tags (workspaces)
bind=SUPER,1,view,1
bind=SUPER,2,view,2
bind=SUPER,3,view,3
bind=SUPER,4,view,4
bind=SUPER,5,view,5
bind=SUPER,6,view,6
bind=SUPER,7,view,7
bind=SUPER,8,view,8
bind=SUPER,9,view,9
bind=SUPER,0,view,0

bind=SUPER+SHIFT,1,tag,1
bind=SUPER+SHIFT,2,tag,2
bind=SUPER+SHIFT,3,tag,3
bind=SUPER+SHIFT,4,tag,4
bind=SUPER+SHIFT,5,tag,5
bind=SUPER+SHIFT,6,tag,6
bind=SUPER+SHIFT,7,tag,7
bind=SUPER+SHIFT,8,tag,8
bind=SUPER+SHIFT,9,tag,9
bind=SUPER+SHIFT,0,tag,0

# Layout
bind=SUPER,s,setlayout,scroller
bind=SUPER,w,setlayout,monocle
bind=SUPER,e,switch_layout
bind=SUPER,f,togglefullscreen
bind=SUPER+SHIFT,space,togglefloating
bind=SUPER,a,zoom

# Scratchpad (minimized windows)
bind=SUPER+SHIFT,minus,minimized
bind=SUPER,minus,restore_minimized

# Resize mode
keymode=resize
bind=NONE,h,resizewin,-10,0
bind=NONE,j,resizewin,0,+10
bind=NONE,k,resizewin,0,-10
bind=NONE,l,resizewin,+10,0
bind=NONE,Left,resizewin,-10,0
bind=NONE,Down,resizewin,0,+10
bind=NONE,Up,resizewin,0,-10
bind=NONE,Right,resizewin,+10,0
bind=NONE,Return,setkeymode,default
bind=NONE,Escape,setkeymode,default

keymode=default
bind=SUPER,r,setkeymode,resize

# Media keys (via noctalia IPC)
bindl=NONE,XF86AudioMute,spawn,noctalia msg volume-mute
bindl=NONE,XF86AudioLowerVolume,spawn,noctalia msg volume-down
bindl=NONE,XF86AudioRaiseVolume,spawn,noctalia msg volume-up
bindl=NONE,XF86AudioMicMute,spawn,noctalia msg mic-mute
bindl=NONE,XF86AudioRecord,spawn,noctalia msg mic-mute
bindl=NONE,XF86AudioPlay,spawn,noctalia msg media toggle
bindl=NONE,XF86AudioPause,spawn,noctalia msg media toggle
bindl=NONE,XF86AudioNext,spawn,noctalia msg media next
bindl=NONE,XF86AudioPrev,spawn,noctalia msg media previous
bindl=NONE,XF86AudioStop,spawn,noctalia msg media stop
bindl=NONE,XF86Search,spawn,noctalia msg panel-toggle launcher
bindl=NONE,XF86MonBrightnessDown,spawn,noctalia msg brightness-down
bindl=NONE,XF86MonBrightnessUp,spawn,noctalia msg brightness-up

# Utilities
bind=SUPER,n,spawn,noctalia msg screenshot-region
bind=SUPER,m,spawn,noctalia msg screenshot-fullscreen
bind=SUPER,p,spawn,noctalia msg session lock
bind=SUPER,u,spawn_shell,rofimoji --files emojis_smileys_emotion emojis_people_body emojis_animals_nature emojis_food_drink emojis_activities emojis_travel_places emojis_objects emojis_symbols emojis_flags miscellaneous_symbols dingbats arrows mathematical_operators letterlike_symbols general_punctuation currency_symbols
bind=SUPER,c,spawn,hyprpicker -a

source=~/.config/mango/noctalia.conf
