+/* Name of TAG (1-based): the first non-wildcard tag_rule for it that sets
+ * name:, falling back to the preset numeric name. */
+const char *get_tag_name(uint32_t tag) {
+	if (tag < 1 || tag > LENGTH(tags))
+		return NULL;
+	for (int32_t i = 0; i < config.tag_rules_count; i++) {
+		const ConfigTagRule *tr = &config.tag_rules[i];
+		if (!tr->id_wildcard && tr->id == (int32_t)tag && tr->name)
+			return tr->name;
+	}
+	return tags[tag - 1];
+}
+
+/* Rename TAG at runtime by updating (or appending) its tag_rule.  Lasts until
+ * the next config reload unless the config file sets the same name. */
+bool set_tag_name(uint32_t tag, const char *name) {
+	if (tag < 1 || tag > LENGTH(tags) || !name || !*name)
+		return false;
+
+	ConfigTagRule *rule = NULL;
+	for (int32_t i = 0; i < config.tag_rules_count; i++) {
+		if (!config.tag_rules[i].id_wildcard &&
+			config.tag_rules[i].id == (int32_t)tag) {
+			rule = &config.tag_rules[i];
+			break;
+		}
+	}
+
+	if (!rule) {
+		ConfigTagRule *rules =
+			realloc(config.tag_rules,
+					(config.tag_rules_count + 1) * sizeof(ConfigTagRule));
+		if (!rules)
+			return false;
+		config.tag_rules = rules;
+		rule = &config.tag_rules[config.tag_rules_count++];
+		memset(rule, 0, sizeof(*rule));
+		rule->id = (int32_t)tag;
+		rule->scroller_ignore_proportion_single = -1;
+	}
+
+	char *copy = strdup(name);
+	if (!copy)
+		return false;
+	free(rule->name);
+	rule->name = copy;
+	return true;
+}
